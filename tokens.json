{
  "$comment": "Advertflair design tokens. Source of truth: advertflair-design-system.css (advertflair.ai production). Fonts: Urbanist headings + Inter body.",
  "version": "1.0.0",
  "brand": {
    "purple": "#4934bc",
    "pink": "#fe2267",
    "orange": "#ff9e02",
    "dark": "#08060f",
    "card": "#110e1c",
    "elevated": "#1a1530"
  },
  "color": {
    "light": {
      "background": "#f8fafc",
      "foreground": "#1a1530",
      "card": "#ffffff",
      "primary": "#4934bc",
      "primaryForeground": "#ffffff",
      "muted": "#f1f5f9",
      "mutedForeground": "#64748b",
      "destructive": "#d4183d",
      "border": "rgba(0,0,0,0.08)",
      "inputBackground": "#f3f3f5",
      "ring": "#4934bc"
    },
    "dark": {
      "background": "#08060f",
      "foreground": "#e2e8f0",
      "card": "#110e1c",
      "primary": "#4934bc",
      "primaryForeground": "#ffffff",
      "muted": "#1a1530",
      "mutedForeground": "#94a3b8",
      "destructive": "#d4183d",
      "border": "rgba(255,255,255,0.08)",
      "inputBackground": "#1a1530",
      "ring": "#4934bc"
    }
  },
  "gradient": {
    "brand": "linear-gradient(135deg, #fe2267, #ff9e02)",
    "purplePink": "linear-gradient(135deg, #4934bc, #fe2267)",
    "brandFull": "linear-gradient(135deg, #4934bc, #fe2267, #ff9e02)",
    "darkBackground": "linear-gradient(135deg, #08060f 0%, #1a1530 50%, #110e1c 100%)"
  },
  "typography": {
    "fontFamily": {
      "heading": "Urbanist, sans-serif",
      "body": "Inter, sans-serif",
      "blogSerif": "'DM Serif Display', serif",
      "blogSans": "'Instrument Sans', sans-serif"
    },
    "scale": {
      "h1": { "size": "3.75rem", "weight": 800, "lineHeight": 1.1, "letterSpacing": "-0.02em" },
      "h2": { "size": "2.5rem", "weight": 700, "lineHeight": 1.2 },
      "h3": { "size": "1.5rem", "weight": 600, "lineHeight": 1.4 },
      "h4": { "size": "1.125rem", "weight": 600, "lineHeight": 1.5 },
      "body": { "size": "1.125rem", "weight": 400, "lineHeight": 1.6 },
      "label": { "size": "1rem", "weight": 500, "lineHeight": 1.5 },
      "eyebrow": { "size": "0.875rem", "weight": 700, "letterSpacing": "0.1em", "transform": "uppercase" },
      "caption": { "size": "0.875rem", "weight": 400 }
    }
  },
  "radius": { "sm": "10px", "md": "12px", "lg": "14px", "xl": "18px", "pill": "360px" },
  "shadow": {
    "light": {
      "subtle": "0 4px 12px rgba(0,0,0,0.1)",
      "medium": "0 10px 30px rgba(0,0,0,0.15)",
      "strong": "0 20px 60px rgba(0,0,0,0.3)"
    },
    "dark": {
      "subtle": "0 4px 12px rgba(0,0,0,0.5)",
      "medium": "0 10px 30px rgba(0,0,0,0.6)",
      "strong": "0 20px 60px rgba(0,0,0,0.8)"
    }
  },
  "motion": {
    "easing": "cubic-bezier(0.23, 1, 0.32, 1)",
    "durationFast": "0.2s",
    "durationBase": "0.3s",
    "durationSlow": "0.6s"
  },
  "spacing": {
    "sectionPaddingMobile": "5rem 1.5rem",
    "sectionPaddingDesktop": "7rem 1.5rem",
    "containerMax": "1280px"
  },
  "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" }
}
